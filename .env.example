# ReverseTutor â€” Environment Variables Template
#
# Copy file ini jadi ".env.local" (JANGAN commit .env.local ke git â€” pastikan
# sudah masuk .gitignore, Next.js biasanya sudah otomatis mengabaikannya).
# Isi tiap value di bawah dengan kredensial asli sebelum menjalankan project.

# â”€â”€ Supabase â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Didapat dari: Supabase Dashboard > Project Settings > API
# NEXT_PUBLIC_* boleh terekspos ke browser (memang didesain begitu oleh
# Supabase, aman karena diproteksi RLS). JANGAN pernah expose service role key
# dengan prefix NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hanya dipakai di server-side (Route Handlers), TIDAK boleh prefix
# NEXT_PUBLIC_. Dipakai hanya jika backend perlu bypass RLS untuk operasi
# tertentu yang sudah divalidasi lewat token user (lihat catatan RLS di
# API_CONTRACT.md bagian 6). Kalau tidak perlu, jangan diisi/dipakai sama
# sekali â€” lebih aman selalu lewat anon key + RLS.
SUPABASE_SERVICE_ROLE_KEY=

# â”€â”€ LLM Provider â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Pilih salah satu (atau keduanya untuk fallback), sesuaikan dengan kode di
# Route Handler /api/chat

# Google Gemini â€” didapat dari https://aistudio.google.com/apikey
# Gunakan model string "gemini-3.5-flash" (model Flash terbaru Google, GA
# sejak Mei 2026). Hindari string lama seperti "gemini-1.5-flash" atau
# "gemini-2.5-flash" â€” kemampuannya di bawah versi 3.5.
#
# CATATAN RATE LIMIT (per info terakhir yang bisa diverifikasi, cek ulang di
# https://aistudio.google.com/ > API Keys > Rate limits karena angka ini
# sering berubah): tier gratis berbagi kuota antara API dan AI Studio,
# sekitar 5-15 request/menit dan ~250.000 token/menit. Google diketahui
# memangkas limit tier gratis signifikan (50-80%) pada Desember 2025 karena
# penyalahgunaan, jadi limit ini JAUH LEBIH KETAT dibanding generasi Gemini
# sebelumnya. Untuk aplikasi chat interaktif seperti ReverseTutor, 5-15
# request/menit bisa cepat habis kalau testing intensif atau demo berkali-kali
# berturut-turut â€” siapkan Groq sebagai fallback atau uji limit ini lebih
# awal di project kamu sendiri sebelum terlalu bergantung padanya.
GEMINI_API_KEY=

# Groq â€” didapat dari https://console.groq.com/keys
GROQ_API_KEY=

# â”€â”€ Catatan â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# - Setelah mengisi .env.local, restart dev server (next dev) supaya
#   perubahan env var terbaca
# - Untuk deploy ke Vercel, isi ulang semua variable ini di:
#   Vercel Dashboard > Project > Settings > Environment Variables
# - JANGAN taruh key asli di file mana pun yang ter-commit ke git, termasuk
#   di komentar kode atau file dokumentasi lain
